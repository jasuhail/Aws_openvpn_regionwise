# Local .terraform directories
**/.terraform/
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json
**/terraform.tfvars
**/*.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfvars files you do wish to add to version control
!**/example.tfvars
!**/terraform.tfvars.example

# CLI configuration files
.terraformrc
terraform.rc

# Lock files (keep if you want to track provider versions)
# .terraform.lock.hcl

# Plan files
*.plan
*.tfplan
tfplan

# Sensitive variables files
*.pem
*.key
*.secret

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE specific
.vscode/
.idea/
*.sublime-*
.project
.classpath

# Logs
*.log

# Backup files
*.backup
*.bak

# Environment files
.env
.env.local
.env.*.local

# Terraform debug files
terraform-debug.log